rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }
  }
}
